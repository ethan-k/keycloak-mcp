# Keycloak MCP Server Configuration

# Base URL of your Keycloak instance
KEYCLOAK_BASE_URL=http://localhost:8080

# Realm to authenticate against (usually 'master' for admin operations)
KEYCLOAK_REALM=master

# Client ID for authentication
KEYCLOAK_CLIENT_ID=admin-cli

# === Option 1: Password Grant (for admin user) ===
# Username and password for authentication
KEYCLOAK_USERNAME=admin
KEYCLOAK_PASSWORD=admin

# === Option 2: Client Credentials Grant (for service accounts) ===
# Client secret for authentication (uncomment if using client credentials)
# KEYCLOAK_CLIENT_SECRET=your-client-secret-here
